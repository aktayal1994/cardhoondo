# Next.js reads .env.local from THIS directory (web/), not the repo-root
# .env the Python scripts use -- copy the matching values from the root
# .env.example / .env once you have them, into a new web/.env.local.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
GEMINI_API_KEY=your-gemini-key-here

# Turns on Google sign-in and saved searches. Leave unset/0 until the Google + Supabase setup is done.
NEXT_PUBLIC_AUTH_ENABLED=0
# Public site URL used for OAuth redirects (defaults to the request origin).
SITE_URL=
